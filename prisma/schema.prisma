model VolunteeringOpportunity {
  id                String                    @id @default(cuid())
  title             String
  description       String?
  type              String
  imageUrl          String?
  requiredPeople    Int                       @default(1)
  currentApplicants Int                       @default(0)
  assignedPeople    Int                       @default(0)
  isAssigned        Boolean                   @default(false)
  coordinatorId     String
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  coordinator       User                      @relation(fields: [coordinatorId], references: [id])
  applications      VolunteeringApplication[]
  customFields      Json?
}

model VolunteeringApplication {
  id               String                  @id @default(cuid())
  opportunityId    String
  applicantId      String
  status           ApplicationStatus       @default(PENDING)
  appliedAt        DateTime                @default(now())
  opportunity      VolunteeringOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  applicant        User                    @relation(fields: [applicantId], references: [id])
  coordinatorNotes String?
}

model ProjectApplication {
  id          String            @id @default(cuid())
  projectId   String
  applicantId String
  notes       String?
  status      ApplicationStatus @default(PENDING)
  appliedAt   DateTime          @default(now())
  project     Event             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  applicant   User              @relation(fields: [applicantId], references: [id])

  @@unique([projectId, applicantId])
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model FinancialSupportRequest {
  id              String                 @id @default(cuid())
  userId          String? // Optional, for anonymous requests
  user            User?                  @relation(fields: [userId], references: [id])
  name            String? // Name of requester if not a registered user
  email           String?
  phone           String?
  amountRequested Float
  reason          String
  status          FinancialSupportStatus @default(PENDING)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
}

enum FinancialSupportStatus {
  PENDING
  APPROVED
  REJECTED
  IN_REVIEW
}

model LiveStream {
  id          String   @id @default(cuid())
  streamUrl   String?
  isLive      Boolean  @default(false)
  platform    String?
  mediaType   String?
  viewerCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
