generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id             String     @id @default(cuid())
  name           String?
  email          String?    @unique
  emailVerified  DateTime?
  image          String?
  phone          String?
  address        String?
  membersince    String?
  birthdate      String?
  photo          String?
  password       String?
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  familyId       String?
  roles          RoleName[]
  roleId         Int?
  christian      Boolean?
  accounts       Account[]
  uploadedAssets Asset[]
  auditLogs      AuditLog[]

  attendedSessions          CounselingSession[]       @relation("Client")
  counselingSessions        CounselingSession[]       @relation("Counselor")
  createFamily              Family?                   @relation("createdBy")
  feedback                  Feedback[]
  ForumPost                 ForumPost[]
  ForumTopic                ForumTopic[]
  ledGroups                 Group[]
  receivedMessages          Message[]                 @relation("ReceivedMessages")
  sentMessages              Message[]                 @relation("SentMessages")
  ledMinistries             Ministry[]
  ministryMemberships       MinistryMember[]
  parentalControl           ParentalControl?
  participants              Participant[]
  polls                     Poll[]
  postFeedbacks             PostFeedback[]
  prayerRequest             PrayerRequest[]
  pushSubscriptions         PushSubscription[]
  sermons                   Sermon[]
  sessions                  Session[]
  assignedTickets           Ticket[]                  @relation("AssignedTickets")
  createdTickets            Ticket[]                  @relation("CreatedTickets")
  topicFeedbacks            TopicFeedback[]
  transactions              Transaction[]
  family                    Family?                   @relation("members", fields: [familyId], references: [id])
  Role                      Role?                     @relation(fields: [roleId], references: [id])
  shifts                    VolunteerShift[]
  votes                     Vote[]
  waiverSignatures          WaiverSignature[]
  canvasDesigns             CanvasDesign[] // Add this line
  baptismApplicationStatus  BaptismStatus?
  baptismClassCompleted     Boolean?                  @default(false)
  baptismDate               DateTime?
  certificates              Certificate[]
  volunteeringOpportunities VolunteeringOpportunity[]
  volunteeringApplications  VolunteeringApplication[]
  projectApplications       ProjectApplication[] // Add this line
  followUps                 FollowUp[]
  bibleStudyEnrollments     BibleStudyEnrollment[]
  createdBibleStudyCourses  BibleStudyCourse[]
  RecurringGift             RecurringGift[]
  financialSupportRequests  FinancialSupportRequest[]
  ministryJoinRequests      MinistryJoinRequest[] // Add this line
  SongProposal              SongProposal[]
  songLikes                 SongLike[]
  createdWorshipSets        WorshipSet[]
  sentWorshipMessages       WorshipMessage[]          @relation("WorshipMessageSender")
  receivedWorshipMessages   WorshipMessage[]          @relation("WorshipMessageRecipient")
}

model Certificate {
  id               String            @id @default(cuid())
  userId           String?
  user             User?             @relation(fields: [userId], references: [id])
  certificateType  String
  cloudinaryUrl    String
  issuedDate       DateTime          @default(now())
  eventName        String? // Added this field
  pastorName       String?
  churchName       String?
  churchLocation   String?
  certificateId    String?           @unique
  briefDescription String?
  recipientName    String?
  courseId         String?
  course           BibleStudyCourse? @relation(fields: [courseId], references: [id])
}

enum CertificateFrequency {
  QUARTERLY
  ANNUALLY
  BIANNUALLY
}

model BibleStudyCourse {
  id                   String                 @id @default(cuid())
  title                String
  description          String?
  certificateFrequency CertificateFrequency
  startDate            DateTime
  endDate              DateTime
  adminId              String
  admin                User                   @relation(fields: [adminId], references: [id])
  lessons              Lesson[]
  enrollments          BibleStudyEnrollment[]
  certificates         Certificate[]
}

model Lesson {
  id           String           @id @default(cuid())
  title        String
  order        Int
  courseId     String
  course       BibleStudyCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  pdfUrl       String?
  imageUrl     String?
  externalLink String?
  content      String?
  questions    LessonQuestion[]
  progress     LessonProgress[]
  quizAttempts QuizAttempt[]
}

model LessonQuestion {
  id                 String   @id @default(cuid())
  lessonId           String
  lesson             Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  text               String
  options            String[]
  correctAnswerIndex Int
}

model BibleStudyEnrollment {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId     String
  course       BibleStudyCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt   DateTime         @default(now())
  progress     LessonProgress[]
  quizAttempts QuizAttempt[]

  @@unique([userId, courseId])
}

model LessonProgress {
  id           String               @id @default(cuid())
  enrollmentId String
  enrollment   BibleStudyEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt  DateTime?

  @@unique([enrollmentId, lessonId])
}

model QuizAttempt {
  id           String               @id @default(cuid())
  enrollmentId String
  enrollment   BibleStudyEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  score        Float
  summary      Json
  attemptedAt  DateTime             @default(now())
}

enum BaptismStatus {
  PENDING
  APPROVED
  REJECTED
  SCHEDULED
  COMPLETED
}

model Family {
  id          String   @id @default(cuid())
  name        String
  createdById String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation("createdBy", fields: [createdById], references: [id])
  members     User[]   @relation("members")
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model Ministry {
  id                   String                @id @default(cuid())
  name                 String
  description          String?
  leaderId             String
  photo                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  events               Event[]
  groups               Group[]
  leader               User                  @relation(fields: [leaderId], references: [id])
  members              MinistryMember[]
  budgets              MinistryBudget[]
  ministryJoinRequests MinistryJoinRequest[] // Add this line
}

model MinistryBudget {
  id              String   @id @default(cuid())
  ministryId      String
  ministry        Ministry @relation(fields: [ministryId], references: [id])
  fiscalYear      Int
  allocatedAmount Float
  spentAmount     Float    @default(0)
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([ministryId, fiscalYear])
}

model MinistryMember {
  ministryId String
  userId     String
  active     Boolean  @default(true)
  joinDate   DateTime @default(now())
  role       String?
  ministry   Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])

  @@id([ministryId, userId])
}

model MinistryJoinRequest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  ministryId  String
  ministry    Ministry @relation(fields: [ministryId], references: [id])
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  requestedAt DateTime @default(now())

  @@unique([userId, ministryId])
}

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  ministryId  String
  leaderId    String
  createdAt   DateTime @default(now())
  meetings    Event[]
  leader      User     @relation(fields: [leaderId], references: [id])
  ministry    Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)
}

model Event {
  id                  String               @id @default(cuid())
  title               String
  description         String?
  imageUrl            String?
  type                EventType
  date                DateTime?
  location            String?
  tags                String[]
  latitude            Float?
  longitude           Float?
  time                String?
  ministryId          String?
  groupId             String?
  createdAt           DateTime             @default(now())
  media               Asset[]
  group               Group?               @relation(fields: [groupId], references: [id])
  ministry            Ministry?            @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  feedback            Feedback[]
  financials          Financials?
  Message             Message[]
  participants        Participant[]
  resourceAllocations ResourceAllocation[]
  sponsors            Sponsor[]
  worshipResources    WorshipResource[]
  projectApplications ProjectApplication[] // Add this line
}

model WorshipSet {
  id            String   @id @default(cuid())
  title         String
  date          DateTime
  leaderId      String
  leader        User     @relation(fields: [leaderId], references: [id])
  arrangedSongs String[] // Ordered list of SongProposal IDs
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WorshipResource {
  id        String    @id @default(cuid())
  title     String
  url       String
  assetType AssetType @map("type")
  serviceId String
  createdAt DateTime  @default(now())
  service   Event     @relation(fields: [serviceId], references: [id])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  tags      String[] @default([])
  createdAt DateTime @default(now())
}

model SongProposal {
  id           String     @id @default(cuid())
  title        String
  artist       String
  youtubeUrl   String? // Optional YouTube link
  spotifyUrl   String? // Optional Spotify link
  userId       String // ID of the user who submitted the proposal
  user         User       @relation(fields: [userId], references: [id])
  likes        Int        @default(0) // Added for like functionality
  createdAt    DateTime   @default(now())
  likesByUsers SongLike[]
}

model SongLike {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  songProposalId String
  songProposal   SongProposal @relation(fields: [songProposalId], references: [id])
  createdAt      DateTime     @default(now())

  @@unique([userId, songProposalId]) // Ensures a user can like a song only once
}

enum ResourceType {
  PDF
  VIDEO
  ARTICLE
  IMAGE
  LINK
  EQUIPMENT
  VENUE
}

model Resource {
  id                  String               @id @default(cuid())
  title               String
  description         String?
  url                 String
  category            Category
  type                ResourceType
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  resourceAllocations ResourceAllocation[]
}

model ResourceAllocation {
  id         String   @id @default(cuid())
  eventId    String
  resourceId String
  quantity   Int
  event      Event    @relation(fields: [eventId], references: [id])
  resource   Resource @relation(fields: [resourceId], references: [id])
}

model Participant {
  id      String @id @default(cuid())
  eventId String
  userId  String
  status  String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Financials {
  id             String  @id @default(cuid())
  eventId        String? @unique
  budget         Float
  expenses       Float
  revenue        Float
  vendorPayments Json
  event          Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Sponsor {
  id      String @id @default(cuid())
  name    String
  amount  Float
  logoUrl String
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])
}

model NewsletterSubscriber {
  id    String @id @default(cuid())
  email String @unique
}

model Feedback {
  id        String    @id @default(cuid())
  eventId   String?
  userId    String
  sentiment Sentiment
  comment   String
  tags      String[]
  imageUrl  String? // Added for image support
  createdAt DateTime  @default(now())
  event     Event?    @relation(fields: [eventId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
}

model Asset {
  id          String    @id @default(cuid())
  title       String
  content     String? // Added for blog post content
  type        AssetType
  url         String?
  uploaderId  String
  eventId     String?
  sermonId    String?   @unique
  tags        String[]
  createdAt   DateTime  @default(now())
  event       Event?    @relation(fields: [eventId], references: [id])
  uploader    User      @relation(fields: [uploaderId], references: [id])
  sermon      Sermon?
  description String?
}

model Sermon {
  id         String   @id @default(cuid())
  title      String
  date       DateTime
  speakerId  String
  videoAsset Asset    @relation(fields: [id], references: [sermonId])
  speaker    User     @relation(fields: [speakerId], references: [id])
}

model Transaction {
  id                   String               @id @default(cuid())
  type                 TransactionType
  amount               Float
  method               TransactionMethod
  description          String?
  userId               String?
  email                String?
  donationPlanId       String?
  donorName            String?
  donorEmail           String?
  recurring            Boolean              @default(false)
  date                 DateTime             @default(now())
  anomaly              Boolean              @default(false)
  reconciliationStatus ReconciliationStatus @default(PENDING)
  donationPlan         DonationPlan?        @relation(fields: [donationPlanId], references: [id])
  user                 User?                @relation(fields: [userId], references: [id])
}

enum ReconciliationStatus {
  PENDING
  APPROVED
  FLAGGED
}

model DonationPlan {
  id           String           @id @default(cuid())
  name         String
  description  String?
  email        String?
  imageUrl     String?
  goalAmount   Float?
  type         DonationPlanType
  fundId       String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  fund         DonationFund?    @relation(fields: [fundId], references: [id])
  transactions Transaction[]
}

enum DonationPlanType {
  PROJECT
  MINISTRY
  USER_REQUEST
  GENERAL
}

model DonationFund {
  id           String         @id @default(cuid())
  name         String
  description  String?
  goalAmount   String?
  raisedAmount String?
  plans        DonationPlan[]
}

model Gateway {
  id       String @id @default(cuid())
  provider String @unique // e.g., "Stripe", "PayPal", "MPesa"
  status   String // "Online", "Offline"
}

model RecurringGift {
  id        String   @id @default(cuid())
  donorId   String // Assuming this links to a User or a separate Donor model
  amount    Float
  startDate DateTime @default(now())
  endDate   DateTime
  status    String // e.g., "Active", "Paused", "LowGiving", "Expired"
  userId    String? // Optional link to User model
  user      User?    @relation(fields: [userId], references: [id])
}

model Ticket {
  id         String   @id @default(cuid())
  issue      String
  priority   Urgency
  status     String
  creatorId  String
  assigneeId String?
  createdAt  DateTime @default(now())
  assignee   User?    @relation("AssignedTickets", fields: [assigneeId], references: [id])
  creator    User     @relation("CreatedTickets", fields: [creatorId], references: [id])
}

model Partner {
  id      String      @id @default(cuid())
  name    String
  type    PartnerType
  mouUrl  String?
  contact String
}

model CounselingTopic {
  id                 String              @id @default(cuid())
  name               String              @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  counselingSessions CounselingSession[]
}

model CounselingSession {
  id          String           @id @default(cuid())
  counselorId String?
  clientId    String?
  date        DateTime
  status      String
  notes       String?
  topicId     String?
  progress    Int
  client      User?            @relation("Client", fields: [clientId], references: [id])
  counselor   User?            @relation("Counselor", fields: [counselorId], references: [id])
  topic       CounselingTopic? @relation(fields: [topicId], references: [id])
  followUps   FollowUp[]
}

model FollowUp {
  id                  String             @id @default(cuid())
  userId              String
  counselingSessionId String?
  days                Int
  response            String
  followUpDate        DateTime           @default(now())
  user                User               @relation(fields: [userId], references: [id])
  counselingSession   CounselingSession? @relation(fields: [counselingSessionId], references: [id])
}

model Waiver {
  id         String            @id @default(cuid())
  title      String
  content    String
  signatures WaiverSignature[]
}

model WaiverSignature {
  id       String   @id @default(cuid())
  waiverId String
  userId   String
  signedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id])
  waiver   Waiver   @relation(fields: [waiverId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String?
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model VolunteerShift {
  id              String   @id @default(cuid())
  userId          String
  eventId         String
  time            String
  conflictCheck   Boolean  @default(false)
  replacementPool String[]
  checkedIn       Boolean  @default(false)
  user            User     @relation(fields: [userId], references: [id])
}

model PrayerRequest {
  id            String       @id @default(cuid())
  request       String
  isUrgent      Boolean      @default(false)
  isPublic      Boolean      @default(true)
  userId        String?
  createdAt     DateTime     @default(now())
  status        PrayerStatus @default(PENDING)
  dailyRoomUrl  String?
  dailyRoomName String?
  user          User?        @relation(fields: [userId], references: [id])
}

model ThemeOfTheWeek {
  id        String   @id @default(cuid())
  title     String
  verse     String
  reference String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ParentalControl {
  id                    String  @id @default(cuid())
  userId                String  @unique
  contentFilter         Boolean @default(false)
  activityMonitoring    Boolean @default(false)
  screenTimeLimit       Boolean @default(false)
  screenTimeHours       Int     @default(0)
  messagingRestrictions Boolean @default(false)
  user                  User    @relation(fields: [userId], references: [id])
}

model Message {
  id          String      @id @default(cuid())
  senderId    String
  recipientId String? // Make recipientId nullable for community messages
  eventId     String?
  subject     String
  content     String
  read        Boolean     @default(false)
  type        MessageType @default(GENERAL)
  createdAt   DateTime    @default(now())
  event       Event?      @relation(fields: [eventId], references: [id])
  recipient   User?       @relation("ReceivedMessages", fields: [recipientId], references: [id])
  sender      User        @relation("SentMessages", fields: [senderId], references: [id])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model ForumTopic {
  id             String          @id @default(cuid())
  title          String
  content        String
  userId         String
  imageUrl       String?
  videoUrl       String?
  likes          Int             @default(0)
  dislikes       Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  posts          ForumPost[]
  user           User            @relation(fields: [userId], references: [id])
  topicFeedbacks TopicFeedback[]
}

model ForumPost {
  id        String         @id @default(cuid())
  content   String
  userId    String
  topicId   String
  imageUrl  String?
  videoUrl  String?
  likes     Int            @default(0)
  dislikes  Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  topic     ForumTopic     @relation(fields: [topicId], references: [id])
  user      User           @relation(fields: [userId], references: [id])
  feedback  PostFeedback[]
}

model TopicFeedback {
  id        String       @id @default(cuid())
  userId    String
  topicId   String
  type      FeedbackType
  createdAt DateTime     @default(now())
  topic     ForumTopic   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id])

  @@unique([userId, topicId])
}

model PostFeedback {
  id        String       @id @default(cuid())
  userId    String
  postId    String
  type      FeedbackType
  createdAt DateTime     @default(now())
  post      ForumPost    @relation(fields: [postId], references: [id])
  user      User         @relation(fields: [userId], references: [id])

  @@unique([userId, postId])
}

model FinancialSetting {
  id                String   @id @default(cuid())
  annualBudgetLimit Float
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Poll {
  id          String       @id @default(cuid())
  title       String
  description String?
  createdAt   DateTime     @default(now())
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id])
  options     PollOption[]
  votes       Vote[]
}

model PollOption {
  id     String @id @default(cuid())
  text   String
  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id])
  votes  Vote[]
}

model Vote {
  id        String     @id @default(cuid())
  userId    String
  pollId    String
  optionId  String
  createdAt DateTime   @default(now())
  option    PollOption @relation(fields: [optionId], references: [id])
  poll      Poll       @relation(fields: [pollId], references: [id])
  user      User       @relation(fields: [userId], references: [id])

  @@unique([userId, pollId])
}

model Institution {
  id          String   @id @default(cuid())
  name        String
  type        String
  description String?
  address     String?
  contactInfo String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PastorQuestion {
  id          String  @id @default(cuid())
  name        String
  email       String?
  phone       String?
  topic       String
  description String
}

model CanvasDesign {
  id        String   @id @default(cuid())
  name      String
  imageUrl  String
  jsonData  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
}

model WorshipMessage {
  id                String      @id @default(cuid())
  content           String
  createdAt         DateTime    @default(now())
  senderId          String
  sender            User        @relation("WorshipMessageSender", fields: [senderId], references: [id])
  recipientId       String
  recipient         User        @relation("WorshipMessageRecipient", fields: [recipientId], references: [id])
  worshipMinistryId String?
  messageType       MessageType @default(GENERAL) // Added messageType
  read              Boolean     @default(false)

  @@index([worshipMinistryId])
}

enum MessageType {
  GENERAL
  EVENT_QUERY
  SUPPORT
  FEEDBACK
  MINISTRY_INQUIRY
  WORSHIP_TEAM
  PASTORAL_CARE // Added PASTORAL_CARE
}

enum RoleName {
  ADMIN
  MEMBER
  GUEST
  PRAYER_MANAGER
  COUNSELOR
  VOLUNTEER
  EVENTS_MANAGER
  SENIOR_PASTOR
  FINANCE_ADMINISTRATOR
  VOLUNTEER_COORDINATOR
  WORSHIP_LEADER
  OVERALL_MINISTRIES_COORDINATOR
  MEN_MINISTRY_COORDINATOR
